# Content Refinery Environment Variables
# Copy this to .env.local and fill in the values
# For Render deployment, add these in the Dashboard > Environment

# ===========================================
# DATABASE (Render PostgreSQL)
# Get from Render Dashboard > Database > Connection
# Use Internal URL for same-region connection
# ===========================================
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# ===========================================
# ANTHROPIC / CLAUDE (Required)
# Get from console.anthropic.com
# ===========================================
ANTHROPIC_API_KEY=sk-ant-...

# ===========================================
# DEEPGRAM (Required for transcription)
# Get from console.deepgram.com
# ===========================================
DEEPGRAM_API_KEY=

# ===========================================
# GAMMA (For visual content generation)
# Get from gamma.app account settings
# ===========================================
GAMMA_API_KEY=sk-gamma-...

# ===========================================
# GOOGLE GEMINI (For AI image & video generation)
# Get from aistudio.google.com
# Powers: Nano Banana (images), Veo 3 (videos)
# ===========================================
GEMINI_API_KEY=

# Video provider: "veo" (default) or "runway"
# VIDEO_PROVIDER=veo

# ===========================================
# SHOPIFY (For product catalog)
# ===========================================
SHOPIFY_STORE=store-letstruck
SHOPIFY_ACCESS_TOKEN=shpat_...

# ===========================================
# FILE STORAGE
# ===========================================
UPLOAD_DIR=./uploads
# For Render with disk: UPLOAD_DIR=/app/uploads

# For production with Cloudflare R2:
# CLOUDFLARE_R2_ACCESS_KEY=
# CLOUDFLARE_R2_SECRET_KEY=
# CLOUDFLARE_R2_BUCKET=content-refinery
# CLOUDFLARE_R2_ENDPOINT=

# ===========================================
# TWITTER / X (For publishing)
# Get from developer.twitter.com
# ===========================================
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=

# ===========================================
# META / FACEBOOK & INSTAGRAM
# Get from developers.facebook.com
# ===========================================
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_PAGE_ID=

# ===========================================
# LINKEDIN
# Get from linkedin.com/developers
# ===========================================
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

# ===========================================
# TIKTOK
# Get from developers.tiktok.com
# ===========================================
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ===========================================
# YOUTUBE
# Get from console.cloud.google.com
# ===========================================
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ===========================================
# CONSTANT CONTACT (For email list management)
# Get from app.constantcontact.com/pages/dma/portal
# ===========================================
CONSTANT_CONTACT_CLIENT_ID=
CONSTANT_CONTACT_CLIENT_SECRET=
CONSTANT_CONTACT_REDIRECT_URI=https://content-refinery-07dc.onrender.com/api/auth/constantcontact/callback

# ===========================================
# RESEND (For transactional emails)
# Get from resend.com/api-keys
# Free tier: 3,000 emails/month
# Used for: Lead magnet delivery emails
# ===========================================
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=kevin@letstruck.com
RESEND_FROM_NAME=Kevin Rutherford

# ===========================================
# APP CONFIGURATION
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
# For Render: NEXT_PUBLIC_APP_URL=https://your-app.onrender.com

# Cron job authentication (for metrics collection)
CRON_SECRET=your-secret-key-here
