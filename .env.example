# Content Refinery Environment Variables
# Copy this to .env.local and fill in the values
# For Render deployment, add these in the Dashboard > Environment

# ===========================================
# DATABASE (Render PostgreSQL)
# Get from Render Dashboard > Database > Connection
# Use Internal URL for same-region connection
# ===========================================
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# ===========================================
# ANTHROPIC / CLAUDE (Required)
# Get from console.anthropic.com
# ===========================================
ANTHROPIC_API_KEY=sk-ant-...

# ===========================================
# DEEPGRAM (Required for transcription)
# Get from console.deepgram.com
# ===========================================
DEEPGRAM_API_KEY=

# ===========================================
# SHOPIFY (For product catalog)
# ===========================================
SHOPIFY_STORE=store-letstruck
SHOPIFY_ACCESS_TOKEN=shpat_...

# ===========================================
# FILE STORAGE
# ===========================================
UPLOAD_DIR=./uploads
# For Render with disk: UPLOAD_DIR=/app/uploads

# For production with Cloudflare R2:
# CLOUDFLARE_R2_ACCESS_KEY=
# CLOUDFLARE_R2_SECRET_KEY=
# CLOUDFLARE_R2_BUCKET=content-refinery
# CLOUDFLARE_R2_ENDPOINT=

# ===========================================
# TWITTER / X (For publishing)
# Get from developer.twitter.com
# ===========================================
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=

# ===========================================
# META / FACEBOOK & INSTAGRAM
# Get from developers.facebook.com
# ===========================================
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_PAGE_ID=

# ===========================================
# LINKEDIN
# Get from linkedin.com/developers
# ===========================================
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

# ===========================================
# TIKTOK
# Get from developers.tiktok.com
# ===========================================
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ===========================================
# YOUTUBE
# Get from console.cloud.google.com
# ===========================================
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ===========================================
# APP CONFIGURATION
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
# For Render: NEXT_PUBLIC_APP_URL=https://your-app.onrender.com
